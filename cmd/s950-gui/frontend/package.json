{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "//browserslist": "Wails ships modern WKWebView (macOS) / WebView2 (Win) / WebKitGTK (Linux). We never run in legacy Chrome, so lint tools shouldn't flag features like color-mix() that need Chrome >= 111.",
  "browserslist": [
    "Chrome >= 111",
    "Edge >= 111",
    "Safari >= 16.4"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^1.0.1",
    "@testing-library/svelte": "^5.3.1",
    "@tsconfig/svelte": "^3.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-svelte": "^2.46.1",
    "globals": "^15.15.0",
    "jsdom": "^25.0.1",
    "svelte": "^3.49.0",
    "svelte-check": "^3.8.6",
    "svelte-preprocess": "^5.1.4",
    "tslib": "^2.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^3.0.7",
    "vitest": "^2.1.9"
  }
}
